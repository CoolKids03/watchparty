
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watch-party-youtube",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "durable_objects": {
    "bindings": [
      {
        "name": "WATCH_ROOM",
        "class_name": "WatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WatchRoom"]
    }
  ]
}
